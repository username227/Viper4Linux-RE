#!/usr/bin/make -f
# Launchpad builds from source with the same CMake staging rules as our native
# Arch/Ubuntu release jobs. Never run a direct system installation.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake -- \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DVIPER_ENABLE_SYSTEM_INSTALL=ON \
		-DVIPER_SYSTEM_INSTALL_LAYOUT=debian \
		-DBUILD_TESTING=ON

override_dh_auto_install:
	mkdir -p debian/viper4linux-re
	dh_auto_install --buildsystem=cmake --destdir=$(CURDIR)/debian/viper4linux-re
